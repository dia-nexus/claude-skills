{
  "_comment": "構造化ログとイベントの共通フィールドの例。運用ログとプロダクト分析イベントで、時刻・トレースID・版を共通にしておくと、問い合わせから両方をたどれる。",
  "operational_log_example": {
    "timestamp": "2026-10-07T10:05:06.123Z",
    "level": "ERROR",
    "service": "checkout-api",
    "event": "inventory_lookup_failed",
    "message": "在庫APIが3秒以内に応答しなかった",
    "error": {"type": "dependency_timeout", "code": "INVENTORY_TIMEOUT", "retryable": true},
    "trace_id": "4bf92f3577b34da6a3ce929d0e0e4736",
    "span_id": "00f067aa0ba902b7",
    "user_pseudo_id": "u_7f3a…",
    "order_id": "o_12345",
    "app_version": "2.14.0",
    "schema_version": "1"
  },
  "product_event_example": {
    "timestamp": "2026-10-07T10:05:06.200Z",
    "event": "checkout_error_shown",
    "properties": {"error_type": "dependency_timeout", "step": "payment", "recoverable": true, "reference_id": "4bf92f35"},
    "user_pseudo_id": "u_7f3a…",
    "trace_id": "4bf92f3577b34da6a3ce929d0e0e4736",
    "tracking_plan_version": "v3"
  },
  "ai_call_example": {
    "timestamp": "2026-10-07T10:06:00.000Z",
    "event": "gen_ai_call_completed",
    "gen_ai": {"operation.name": "chat", "request.model": "＜頼んだモデル＞", "response.model": "＜実際に答えたモデル＞", "response.finish_reasons": ["max_tokens"], "usage.input_tokens": 1820, "usage.output_tokens": 1024},
    "prompt_version": "summary-v7",
    "response_id": "r_9c1…",
    "latency_ms": 4210,
    "error": {"type": "truncated"},
    "trace_id": "5ce0…",
    "content_logged": false
  },
  "never_log": ["password", "access_token", "credit_card", "full_prompt_text_by_default", "free_text_message_body", "health_or_other_sensitive_attributes"]
}
